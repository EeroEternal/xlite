# 复制为 .env 后由 docker compose 自动加载：
#   cp env.example .env
# 改 .env 再：docker compose up -d

# ----- 网关 xlite -----
ADMIN_PASSWORD=admin
# 多节点共用同一个值；不设则从 ADMIN_PASSWORD 派生
# ADMIN_SESSION_SECRET=
PORT=8080
XLITE_UPSTREAM_H2C=1
XLITE_UPSTREAM_MAX_CONNS_PER_HOST=32
# 可选（默认不设 = 按上游通告的 SETTINGS_MAX_CONCURRENT_STREAMS 执行）：每条上游 h2
# 连接的流预算上限。与 MAX_CONNS_PER_HOST 相乘 = 每 mock 准入流上限，超出在连接池
# 排队（计入 TTFT、不报错）。见 docs/manual/lab-loadtest.md「上游流闸门」
# XLITE_UPSTREAM_STREAM_CAP=40
# 诊断用（默认关）：给流式响应加 x-xlite-upstream-ttft-ms。开启会推迟响应头到上游首字节，
# 对标跑数时必须保持关闭 —— 见 scripts/loadtest/README.md
# XLITE_UPSTREAM_TTFT_HEADER=1
# 0 = freeze snapshot after import (load test)
# XLITE_CATALOG_RELOAD_SECS=0
# Tokio worker 数。**不要留默认**：裸 #[tokio::main] 按核数起（128 核机上 128 个），
# 而本网关是 I/O 型 —— 实测 128→8 线程省 8%，128→2 省 41%（见 docs/dev §12.1）。
# 取 8：唯一在 1000 VU 与 4000 VU 两档都实测过、且都是被测集合里最好的值。
TOKIO_WORKER_THREADS=8
# REDIS_URL 在 compose 里写死为 redis://redis:6379，不要改成 127.0.0.1
# 有 REDIS_URL 时不要设 DATABASE_URL

# ----- mock 农场（一个容器 24 端口）-----
# 冒烟：20；B 组压测：500
MOCK_CHUNKS=20
MOCK_INTERVAL_MS=10
MOCK_TTFT_MS=0
MOCK_MODEL=mock
