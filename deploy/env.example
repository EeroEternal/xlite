# Copy to .env (automatically loaded by docker compose):
#   cp env.example .env
# After editing .env, run: docker compose up -d

# ----- Gateway (xlite) -----
ADMIN_PASSWORD=admin
# Shared across replicas; derived from ADMIN_PASSWORD when unset
# ADMIN_SESSION_SECRET=
PORT=8080
XLITE_UPSTREAM_H2C=1
XLITE_UPSTREAM_MAX_CONNS_PER_HOST=32
# Optional (unset = honour upstream SETTINGS_MAX_CONCURRENT_STREAMS): per-connection
# client-side stream cap. Multiplied by MAX_CONNS_PER_HOST = per-host concurrent stream cap.
# XLITE_UPSTREAM_STREAM_CAP=40
# 0 = freeze snapshot after import (load test)
# XLITE_CATALOG_RELOAD_SECS=0
# Tokio worker count. Recommended: 8 (or 24 for high-chunk-rate streaming workloads).
TOKIO_WORKER_THREADS=8
# Optional async usage & billing webhook URL and Bearer token:
# XLITE_USAGE_WEBHOOK_URL=http://hub:3000/api/gateway/usage
# XLITE_USAGE_WEBHOOK_TOKEN=
# Optional per-attempt event stream (one POST per upstream attempt, for live failover visibility):
# XLITE_ATTEMPT_WEBHOOK_URL=http://hub:3000/api/gateway/attempts
# XLITE_ATTEMPT_WEBHOOK_TOKEN=
# Defaults are 120s (headers) and 300s (silent body); 0 disables either watchdog.
# XLITE_UPSTREAM_HEADER_TIMEOUT_SECS=120
# XLITE_UPSTREAM_STALL_TIMEOUT_SECS=300
# Diagnosing a hang: RUST_LOG=xlite.timing=debug prints one line per upstream phase.
# This logs a single warning when an attempt waits longer than the given ms (default off):
# XLITE_SLOW_WARN_MS=60000
# REDIS_URL is set to redis://redis:6379 in docker-compose.yml; do not set DATABASE_URL when using Redis.
