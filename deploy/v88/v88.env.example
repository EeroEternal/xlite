# ============================================================
# deploy/v88 框架的口径文件。复制成 v88.env 再改。
#   cp v88.env.example v88.env && $EDITOR v88.env
#
# 原则：**口径必须显式写死**。脚本不接受"猜"，读不到字段就报错，而不是用默认值
# 悄悄替你决定（本仓压测史里最贵的一类故障就是"日志看着没问题、口径其实不是那个"）。
# ============================================================

# ----- 目标（必填）-----
# 客户入口：single = :8006，dual = :8005
TARGET=http://10.56.88.31:8006/v1/chat/completions
TOKEN=
MODEL=mock-model

# ----- 农场 -----
# 支持三种写法：`8081-8104`（端口区间）、`4101,4102`（端口列表）、
# `10.0.0.2:8081-8104` 或 `10.0.0.2:4101,10.0.0.3:4101`（**跨机**）。
# ⚠️ 客户包里 `deploy88/start-mocks.sh` 只起 **12** 口（8081–8092），
#    而 `run_full_88.sh` 按 **24** 口配（8081–8104）—— 这里必须与你实际起的一致，
#    脚本会逐口回读校验，配不上的口会让它中止（不是静默）。
MOCKS="8081-8104"

# 农场 mock 机的核数（**你们的 mock 服务器是 32 核**）。
# 用来算产能预算闸门：超预算的档位会被拒绝，而不是让 k6 硬顶到崩。
FARM_CORES=32

# ★ batch 是**口径**，不是性能旋钮。分两套跑：
#   对标 / 延迟类（与客户历史数据可比、要与 New API 比 TTFT）→ 1   ← 客户 driver 写死的就是 1
#   产能 / 天花板类（只想把档位打上去）                          → 5 或 10
# 报告里会被自动标注；batch≠1 时**产品相关的绝对核数不可用**，也不可与 batch=1 的表混算。
MOCK_BATCH=1

MOCK_TTFT=500
MOCK_INTERVAL=10

# ----- k6 -----
K6_IMAGE=grafana/k6:latest
K6_MEM=45g
# 对标口径（与客户那批数据一致）：KEEP_BODY=true + KEEP_SAMPLE=1 ⇒ checks 比 2.00
KEEP_BODY=true
KEEP_SAMPLE=1
# `chunk_interval_ms` 的有界采样：客户 D 组 out=6000 时，无上限版本每次迭代塞 5999 个
# Trend 样本，是 k6 高 VU 下 OOM 的主因。0 = 复刻客户原版（不建议）。
# ⚠️ 不影响 ttft / dur / fail / qps / gateway_overhead_ms。
CHUNK_MAX=64
GRACEFUL_STOP=600s
STREAM_TIMEOUT=600000
WARMUP=30

# ----- 档位 -----
START_VUS=1000
STEP=1000
MAX_VUS=31000
# 客户原版：短流 300s / 长流 640s（B E A 短，D F C 长）
STABLE_SHORT=300s
STABLE_LONG=640s
COMBOS="B D E F A C"
# 1 = 超出农场预算也照跑（诊断用；此时结果**不可作任何网关结论**）
ALLOW_OVER_FARM=0

# ----- 结果 -----
# RESULT_DIR=./results/$(date -u +%Y%m%dT%H%M%SZ)
