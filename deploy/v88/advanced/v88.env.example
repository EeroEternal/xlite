# ============================================================
# deploy/v88 的**变量清单**（可选，不是依赖）：脚本本身**不读任何文件**。
#   直接 export，或者一次性加载：`. ./v88.env.example`
#
# 原则：**口径必须显式写死**。没给的字段用脚本里的保守默认，绝不"猜"——
# 本仓压测史里最贵的一类故障就是"日志看着没问题、口径其实不是那个"。
# ============================================================

# ----- 目标（必填）-----
# 客户入口：single = :8006，dual = :8005
TARGET=http://10.56.88.31:8006/v1/chat/completions
TOKEN=
MODEL=mock-model

# ----- 农场 -----
# 支持三种写法：`8081-8104`（端口区间）、`4101,4102`（端口列表）、
# `10.0.0.2:8081-8104` 或 `10.0.0.2:4101,10.0.0.3:4101`（**跨机**）。
# ⚠️ 客户包里 `deploy88/start-mocks.sh` 只起 **12** 口（8081–8092），
#    而 `run_full_88.sh` 按 **24** 口配（8081–8104）—— 这里必须与你实际起的一致，
#    脚本会逐口回读校验，配不上的口会让它中止（不是静默）。
MOCKS="8081-8104"

# 农场 mock 机的核数。只给 farm_ceiling_scan.sh 算扩容用，对标 driver 不读。
FARM_CORES=32

# ★ batch 是**口径**，不是性能旋钮。分两套跑：
#   对标 / 延迟类（与客户历史数据可比、要与 New API 比 TTFT）→ 1   ← 客户 driver 写死的就是 1
#   产能 / 天花板类（只想把档位打上去）                          → 5 或 10
# 报告里会被自动标注；batch≠1 时**产品相关的绝对核数不可用**，也不可与 batch=1 的表混算。
MOCK_BATCH=1

MOCK_TTFT=500
MOCK_INTERVAL=10

# ----- k6 -----
K6_IMAGE=grafana/k6:latest
# K6_MEM 是 docker 的 -m：**上限不是预留**，同时是本机 k6 的护盾。
#   设小 → k6 自己被杀（rc=137；0927 有 5 档如此，被迫降到 0.01 采样重跑，那 5 档口径与全表不同）
#   设大 → 护盾消失，宿主机 OOM killer 挑受害者 —— 现场 .29 上同时住着 24 个 mock，被杀的可能不是 k6
# driver 会与 /proc/meminfo 比对，超过本机内存一半就告警。升之前先 `free -g`；余量薄就先挪 k6。
K6_MEM=80g
# 对标口径：默认采用客户 v88-dual 分组采样率 (A/E=100% B=50% C/F=10% D=5%)，彻底避免 D 组长流打爆 k6 内存。
# 若需强制全局指定单一采样率，取消注释下面一行：
# KEEP_SAMPLE=1
# `chunk_interval_ms` 的有界采样：客户 D 组 out=6000 时，无上限版本每次迭代塞 5999 个
# Trend 样本，是 k6 高 VU 下 OOM 的主因。0 = 复刻客户原版（不建议）。
# ⚠️ 不影响 ttft / dur / fail / qps / gateway_overhead_ms。
CHUNK_MAX=64
# GRACEFUL_STOP（Go 时长字面量）必须比 STREAM_TIMEOUT（毫秒）留余量，否则窗口末尾发起的
# 请求会在“被记成失败”前被 k6 掐掉 ⇒ fail% / p99 被低估。900s vs 600000ms = 余 300s。
# 客户口径是 600s / 600000ms（**余量 0**）—— 要 1:1 复刻就接受这个洞，driver 只告警不拦。
GRACEFUL_STOP=900s
STREAM_TIMEOUT=600000
WARMUP=30

# ----- 档位 -----
START_VUS=1000
STEP=1000
# ⚠️ **不得低于 60000**（客户双节点那轮的上界）：低一档对标表就缺行，driver 会直接 exit 2。
# 要缩一场跑测请调下面的粗步进/稳态，或用 RESUME 分轮，**不要降上界**。
MAX_VUS=60000
# 客户原版：短流 300s / 长流 640s（B E A 短，D F C 长）
STABLE_SHORT=300s
STABLE_LONG=640s
COMBOS="B D E F A C"

# 两段步进（**默认开**，是口径变更 —— 会写进 env.txt 并在 progress 打 ⚠️）：低载段保持
# 1000 一档（对标最干净的那张表——1000~4000 VU 的 TTFT 就在这一段），VU ≥ STEP_COARSE_ABOVE
# 之后放粗到 STEP_COARSE。末档**一定**落在 MAX_VUS（步进跳过时就补一档）。
# 默认 `1000/10000/5000` ⇒ 每组 20 档、六组 120 档（≈ 16.7 小时载荷窗口 / 实测约 18 小时墙钟）。
# 想要与客户逐档一致：STEP_COARSE_ABOVE=0 ⇒ 每组 60 档。
# 想要更短：STEP_COARSE_ABOVE=5000 STEP_COARSE=5000 ⇒ 每组 16 档。
STEP_COARSE_ABOVE=10000
STEP_COARSE=5000

# 停测规则。客户原版是「连续两档 fail>1% → STOP」；默认 0 = **不停**（跑到 MAX_VUS），
# 因为过载段那几档的 fail 本身就是结论。1 = 恢复客户原版。判定仍用 k6 内置
# `http_req_failed`，指标定义不变。
STOP_ON_FAIL=0

# ----- 结果 -----
# RESULT_DIR=./results/$(date -u +%Y%m%dT%H%M%SZ)
# 分轮续跑：给**同一个** RESULT_DIR 并置 RESUME=1，已有 rc=0 的档复用旧日志、不再跑 k6
# （progress 里标 ♻）。用途是把几十小时的阶梯切成几轮，而不是赌一轮不被打断。
# RESUME=1
