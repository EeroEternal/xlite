# 24-port SSE mock farm for the mock-24 catalog.
#   docker build -f Dockerfile.mock -t xlite-mock:0.1.0 .

FROM node:22-alpine
WORKDIR /app
COPY scripts/stream_mock_server.mjs ./stream_mock_server.mjs
COPY scripts/start_mocks.sh ./start_mocks.sh
RUN chmod +x ./start_mocks.sh
ENV MOCK_MODEL=mock \
    MOCK_CHUNKS=20 \
    MOCK_INTERVAL_MS=10 \
    MOCK_TTFT_MS=0
EXPOSE 4101-4124
CMD ["./start_mocks.sh"]
