# SQLite file (default). For load tests: memory
DATABASE_URL=sqlite:xlite.db
# DATABASE_URL=memory
# Cluster: Redis holds the catalog; SQLITE is unused when this is set
# REDIS_URL=redis://127.0.0.1:6379
PORT=8080
LISTEN_HOST=0.0.0.0
ADMIN_PASSWORD=admin
XLITE_UPSTREAM_H2C=1
XLITE_UPSTREAM_MAX_CONNS_PER_HOST=32
